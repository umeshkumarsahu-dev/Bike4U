# Environment Configuration for Bike for U

NODE_ENV=production
PORT=3000
WEB_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
POSTGRES_USER=bike4u_user
POSTGRES_PASSWORD=bike4u_secure_pass
POSTGRES_DB=bike4u_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://bike4u_user:bike4u_secure_pass@localhost:5433/bike4u_db?schema=public

# Redis
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Headless Chromium
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
